# Copia este archivo a .env (o exporta las variables en tu shell) para configurar el backend.
# Ninguna tiene valores reales: son los defaults documentados en application.properties.

SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER=org.h2.Driver

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
H2_CONSOLE_ENABLED=true

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
